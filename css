body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f4f4;
}

.chat-container {
    max-width: 600px;
    margin: 30px auto;
    background: #ffffff;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    overflow: hidden;
}

.chat-header {
    background: #007bff;
    color: #ffffff;
    padding: 15px;
    text-align: center;
}

.chat-messages {
    padding: 20px;
    height: 400px;
    overflow-y: auto;
    border-bottom: 1px solid #dddddd;
}

.chat-messages .message {
    margin-bottom: 10px;
}

.chat-messages .message .meta {
    font-size: 12px;
    color: #555555;
    margin-bottom: 5px;
}

.chat-messages .message .text {
    font-size: 16px;
    padding: 10px;
    background: #f1f1f1;
    border-radius: 5px;
}

.chat-form-container {
    padding: 10px;
    background: #f4f4f4;
}

.chat-form-container form {
    display: flex;
}

.chat-form-container input {
    flex: 1;
    padding: 10px;
    border: 1px solid #dddddd;
    border-radius: 5px;
    margin-right: 10px;
}

.chat-form-container button {
    padding: 10px 15px;
    background: #007bff;
    color: #ffffff;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.chat-form-container button:hover {
    background: #0056b3;
}